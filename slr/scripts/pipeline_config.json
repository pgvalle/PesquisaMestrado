{
  "version": 1,
  "source_priority": [
    "scopus",
    "wos",
    "ieee",
    "springer"
  ],
  "sources": {
    "scopus": {
      "display_name": "Scopus",
      "input": "../scopus.csv",
      "output_filename": "scopus.csv",
      "title_column": "Title",
      "authors_column": "Authors",
      "content_type_column": "Document Type",
      "allowed_content_types": [
        "Article",
        "Conference paper",
        "Book chapter",
        "Book"
      ]
    },
    "wos": {
      "display_name": "Web of Science",
      "input": "../wos.xls",
      "output_filename": "wos.csv",
      "title_column": "Article Title",
      "authors_column": "Authors",
      "content_type_column": "Document Type",
      "allowed_content_types": [
        "Article",
        "Proceedings Paper",
        "Article; Proceedings Paper",
        "Book",
        "Book Chapter"
      ]
    },
    "ieee": {
      "display_name": "IEEE Xplore",
      "input": "../ieee.csv",
      "output_filename": "ieee.csv",
      "title_column": "Document Title",
      "authors_column": "Authors",
      "content_type_column": "Document Identifier",
      "allowed_content_types": [
        "IEEE Journals",
        "IEEE Conferences",
        "IEEE Books",
        "IEEE Early Access Articles"
      ]
    },
    "springer": {
      "display_name": "Springer Nature Link",
      "input": "../springer.csv",
      "output_filename": "springer.csv",
      "title_column": "Item Title",
      "authors_column": "Authors",
      "content_type_column": "Content Type",
      "allowed_content_types": [
        "Article",
        "Conference paper",
        "Chapter",
        "Book"
      ]
